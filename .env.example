# 只保留变量名和安全说明，禁止提交真实值。
# Supabase Publishable Key 可以暴露给浏览器；Service Role Key 绝不能进入客户端。

# NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 兼容旧项目的可选变量（优先使用 Publishable Key）：
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Phase 4 不需要 Service Role Key；Phase 6 起仅在明确的 server-only 边界使用。
# Phase 6 fal: all variables are server-only. Do not use NEXT_PUBLIC_ prefixes.
# FAL_KEY=
# FAL_TEXT_TO_IMAGE_MODEL=fal-ai/flux/schnell
# FAL_IMAGE_TO_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# FAL_TEXT_TO_SPEECH_MODEL=fal-ai/minimax/speech-02-hd
# Public HTTPS callback base URL; the server appends FAL_WEBHOOK_TOKEN per submission.
# FAL_WEBHOOK_URL=https://your-app.example.com/api/webhooks/fal
# FAL_WEBHOOK_TOKEN=
# Phase 6 webhook receipts and upload metadata require this server-only database key.
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SUBSCRIPTION_PRICE_ID=
# STRIPE_RECURRING_CREDIT_PACK_PRICE_ID=
# Both configured test-mode Prices must be active recurring USD Prices and
# define a positive integer `credits` metadata value. Credits are only granted
# after a signed `invoice.paid` webhook, never from the Checkout return URL.
